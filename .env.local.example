# Copiez ce fichier en .env.local et remplissez les valeurs
# (Project Settings → API dans votre tableau de bord Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx


# Clé publique VAPID pour les notifications push (portail pharmacien).
# Générée avec `npx web-push generate-vapid-keys` — la clé privée ne va
# JAMAIS dans un fichier committé, elle vit uniquement dans Supabase Vault.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
